# DigiBank local environment variables (Workshop 2 remediation)
#
# Copy this file to ".env" (already gitignored) and fill in real local values.
# NEVER commit an actual ".env" file or hardcode these values in application*.yml.
#
# Load them in IntelliJ (Run Configuration > Environment variables), in your shell
# before running Maven/Spring Boot, or via `docker compose --env-file .env`.

# --- Database (dev profile) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/digibankdb
SPRING_DATASOURCE_USERNAME=digibank
SPRING_DATASOURCE_PASSWORD=change-me-locally
POSTGRES_DB=digibank_db
POSTGRES_USER=digibank_user
POSTGRES_PASSWORD=change-me-locally

# --- SonarQube (Workshop 2 SAST) ---
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=replace-with-your-sonar-token

# --- OWASP Dependency-Check ---
# Request a key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your-nvd-api-key-here
